{
  "name": "onion-boy-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "verify-tokens": "node scripts/verify-tokens.mjs",
    "db:init": "node scripts/db-init.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "db:up": "docker compose up -d surrealdb schema-init",
    "db:down": "docker compose down",
    "build": "node scripts/verify-tokens.mjs && tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "puppeteer": "^25.12.0",
    "typescript": "^5.8.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "surrealdb": "^2.0.8"
  }
}
